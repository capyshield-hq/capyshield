{
  "mcpServers": {
    "fetch": {
      "command": "capyshield",
      "args": [
        "guard",
        "--config",
        "capyshield.yaml",
        "--agent-id",
        "mcp-fetch",
        "--",
        "uvx",
        "mcp-server-fetch"
      ]
    },
    "filesystem": {
      "command": "capyshield",
      "args": [
        "guard",
        "--config",
        "capyshield.yaml",
        "--agent-id",
        "mcp-filesystem",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    }
  }
}
